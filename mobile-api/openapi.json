        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Consulta exitosa; listas paginadas con data, pagination y request_id"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "422": {
            "description": "Datos inválidos"
          },
